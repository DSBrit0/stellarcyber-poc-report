# Porta onde o servidor Node.js irá escutar (internamente)
PORT=8080

# IP de escuta:
#   0.0.0.0   → aceita conexões de qualquer IP (recomendado atrás de Nginx)
#   127.0.0.1 → somente localhost (mais seguro quando Nginx está no mesmo servidor)
#   <ip>      → bind em interface específica (ex: 10.0.0.5)
HOST=0.0.0.0

# ─── HTTPS / Nginx (preenchido automaticamente pelo setup-nginx.sh) ───────────

# Domínio público onde o dashboard ficará acessível
# Altere para o seu próprio domínio antes de rodar: sudo bash setup-nginx.sh
DOMAIN=stellarcyber.sekuritylab.com

# E-mail para notificações de renovação do certificado Let's Encrypt (obrigatório)
LETSENCRYPT_EMAIL=
